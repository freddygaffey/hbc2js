{
  "name": "hbc2js-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "hbc2js Stage-3 UI shell (spec 22) — Vite + React + Tailwind, separate package from the zero-runtime-dep root",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:dom": "vitest run",
    "e2e": "node e2e/prepare-fixture.mjs && playwright test --config e2e/playwright.config.ts",
    "e2e:nsw": "PW_BASE_URL=http://127.0.0.1:4173 PW_READONLY=1 playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.3",
    "@codemirror/view": "6.43.11",
    "@dagrejs/dagre": "3.1.1",
    "@lezer/highlight": "1.2.3",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@replit/codemirror-vim": "6.4.0",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-virtual": "3.14.10",
    "@xyflow/react": "12.11.6",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-resizable-panels": "3.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "5.0.0"
  }
}
