{
  "name": "nord",
  "mode": "dark",
  "family": "nord",
  "palette": {
    "bg": "#2e3440",
    "surface": "#3b4252",
    "surface-2": "#434c5e",
    "border": "#4c566a",
    "text": "#eceff4",
    "text-muted": "#d8dee9",
    "accent": "#88c0d0",
    "accent-fg": "#2e3440"
  },
  "severity": {
    "crit": "#bf616a",
    "high": "#d08770",
    "med": "#ebcb8b",
    "ok": "#a3be8c"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#3b4252",
      "border": "#4c566a"
    },
    "level1": {
      "bg": "#434c5e",
      "border": "#4c566a"
    }
  },
  "border": {
    "strong": "#d8dee9",
    "focus": "#88c0d0"
  },
  "syntax": {
    "comment": "#d8dee9",
    "keyword": "#88c0d0",
    "string": "#a3be8c",
    "number": "#ebcb8b",
    "function": "#eceff4",
    "variable": "#eceff4",
    "operator": "#d8dee9",
    "invalid": "#bf616a"
  }
}
