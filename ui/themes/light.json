{
  "name": "light",
  "mode": "light",
  "family": "default",
  "palette": {
    "bg": "#f4f6fa",
    "surface": "#ffffff",
    "surface-2": "#e9edf4",
    "border": "#c9d3e2",
    "text": "#16202e",
    "text-muted": "#5b6b83",
    "accent": "#1f6fc0",
    "accent-fg": "#ffffff"
  },
  "severity": {
    "crit": "#c02551",
    "high": "#a85c14",
    "med": "#8a7412",
    "ok": "#1a7f4f"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#ffffff",
      "border": "#c9d3e2"
    },
    "level1": {
      "bg": "#e9edf4",
      "border": "#c9d3e2"
    }
  },
  "border": {
    "strong": "#5b6b83",
    "focus": "#1f6fc0"
  },
  "syntax": {
    "comment": "#5b6b83",
    "keyword": "#1f6fc0",
    "string": "#1a7f4f",
    "number": "#8a7412",
    "function": "#16202e",
    "variable": "#16202e",
    "operator": "#5b6b83",
    "invalid": "#c02551"
  }
}
