{
  "name": "catppuccin-latte",
  "mode": "light",
  "family": "catppuccin",
  "palette": {
    "bg": "#eff1f5",
    "surface": "#e6e9ef",
    "surface-2": "#ccd0da",
    "border": "#acb0be",
    "text": "#4c4f69",
    "text-muted": "#6c6f85",
    "accent": "#1e66f5",
    "accent-fg": "#eff1f5"
  },
  "severity": {
    "crit": "#d20f39",
    "high": "#fe640b",
    "med": "#df8e1d",
    "ok": "#40a02b"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#e6e9ef",
      "border": "#acb0be"
    },
    "level1": {
      "bg": "#ccd0da",
      "border": "#acb0be"
    }
  },
  "border": {
    "strong": "#6c6f85",
    "focus": "#1e66f5"
  },
  "syntax": {
    "comment": "#6c6f85",
    "keyword": "#1e66f5",
    "string": "#40a02b",
    "number": "#df8e1d",
    "function": "#4c4f69",
    "variable": "#4c4f69",
    "operator": "#6c6f85",
    "invalid": "#d20f39"
  }
}
