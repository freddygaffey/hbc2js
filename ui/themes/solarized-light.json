{
  "name": "solarized-light",
  "mode": "light",
  "family": "solarized",
  "palette": {
    "bg": "#fdf6e3",
    "surface": "#eee8d5",
    "surface-2": "#e4dcc3",
    "border": "#93a1a1",
    "text": "#657b83",
    "text-muted": "#839496",
    "accent": "#268bd2",
    "accent-fg": "#fdf6e3"
  },
  "severity": {
    "crit": "#dc322f",
    "high": "#cb4b16",
    "med": "#b58900",
    "ok": "#859900"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#eee8d5",
      "border": "#93a1a1"
    },
    "level1": {
      "bg": "#e4dcc3",
      "border": "#93a1a1"
    }
  },
  "border": {
    "strong": "#839496",
    "focus": "#268bd2"
  },
  "syntax": {
    "comment": "#839496",
    "keyword": "#268bd2",
    "string": "#859900",
    "number": "#b58900",
    "function": "#657b83",
    "variable": "#657b83",
    "operator": "#839496",
    "invalid": "#dc322f"
  }
}
