{
  "name": "gruvbox-dark",
  "mode": "dark",
  "family": "gruvbox",
  "palette": {
    "bg": "#282828",
    "surface": "#3c3836",
    "surface-2": "#504945",
    "border": "#665c54",
    "text": "#ebdbb2",
    "text-muted": "#a89984",
    "accent": "#83a598",
    "accent-fg": "#282828"
  },
  "severity": {
    "crit": "#fb4934",
    "high": "#fe8019",
    "med": "#fabd2f",
    "ok": "#b8bb26"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": { "unit": "0.3rem", "fontSize": "15px", "rowHeight": "32px" },
    "compact": { "unit": "0.22rem", "fontSize": "13px", "rowHeight": "24px" }
  }
}
