{
  "name": "gruvbox-light",
  "mode": "light",
  "family": "gruvbox",
  "palette": {
    "bg": "#fbf1c7",
    "surface": "#ebdbb2",
    "surface-2": "#d5c4a1",
    "border": "#bdae93",
    "text": "#3c3836",
    "text-muted": "#7c6f64",
    "accent": "#076678",
    "accent-fg": "#fbf1c7"
  },
  "severity": {
    "crit": "#9d0006",
    "high": "#af3a03",
    "med": "#b57614",
    "ok": "#79740e"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#ebdbb2",
      "border": "#bdae93"
    },
    "level1": {
      "bg": "#d5c4a1",
      "border": "#bdae93"
    }
  },
  "border": {
    "strong": "#7c6f64",
    "focus": "#076678"
  },
  "syntax": {
    "comment": "#7c6f64",
    "keyword": "#076678",
    "string": "#79740e",
    "number": "#b57614",
    "function": "#3c3836",
    "variable": "#3c3836",
    "operator": "#7c6f64",
    "invalid": "#9d0006"
  }
}
