{
  "name": "tokyonight",
  "mode": "dark",
  "family": "tokyonight",
  "palette": {
    "bg": "#1a1b26",
    "surface": "#24283b",
    "surface-2": "#292e42",
    "border": "#414868",
    "text": "#c0caf5",
    "text-muted": "#565f89",
    "accent": "#7aa2f7",
    "accent-fg": "#1a1b26"
  },
  "severity": {
    "crit": "#f7768e",
    "high": "#ff9e64",
    "med": "#e0af68",
    "ok": "#9ece6a"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#24283b",
      "border": "#414868"
    },
    "level1": {
      "bg": "#292e42",
      "border": "#414868"
    }
  },
  "border": {
    "strong": "#565f89",
    "focus": "#7aa2f7"
  },
  "syntax": {
    "comment": "#565f89",
    "keyword": "#7aa2f7",
    "string": "#9ece6a",
    "number": "#e0af68",
    "function": "#c0caf5",
    "variable": "#c0caf5",
    "operator": "#565f89",
    "invalid": "#f7768e"
  }
}
