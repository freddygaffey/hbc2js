{
  "name": "catppuccin-mocha",
  "mode": "dark",
  "family": "catppuccin",
  "palette": {
    "bg": "#1e1e2e",
    "surface": "#313244",
    "surface-2": "#45475a",
    "border": "#585b70",
    "text": "#cdd6f4",
    "text-muted": "#a6adc8",
    "accent": "#89b4fa",
    "accent-fg": "#1e1e2e"
  },
  "severity": {
    "crit": "#f38ba8",
    "high": "#fab387",
    "med": "#f9e2af",
    "ok": "#a6e3a1"
  },
  "fonts": {
    "sans": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
  },
  "radius": "4px",
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "7": "32px",
    "8": "40px"
  },
  "density": "comfortable",
  "densities": {
    "comfortable": {
      "unit": "0.3rem",
      "fontSize": "15px",
      "rowHeight": "32px"
    },
    "compact": {
      "unit": "0.22rem",
      "fontSize": "13px",
      "rowHeight": "24px"
    }
  },
  "type": {
    "xs": "0.75rem",
    "sm": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem"
  },
  "elevation": {
    "level0": {
      "bg": "#313244",
      "border": "#585b70"
    },
    "level1": {
      "bg": "#45475a",
      "border": "#585b70"
    }
  },
  "border": {
    "strong": "#a6adc8",
    "focus": "#89b4fa"
  },
  "syntax": {
    "comment": "#a6adc8",
    "keyword": "#89b4fa",
    "string": "#a6e3a1",
    "number": "#f9e2af",
    "function": "#cdd6f4",
    "variable": "#cdd6f4",
    "operator": "#a6adc8",
    "invalid": "#f38ba8"
  }
}
